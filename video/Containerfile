FROM python:3.12-slim

# Same base, env and torch layer as vision/Containerfile, so the build cache shares that layer
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/hf \
    TORCH_HOME=/cache/torch

WORKDIR /srv

# torch in its own layer so changing requirements.txt doesn't re-download it
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.5.1 torchvision==0.20.1

# torchaudio for pyannote's speaker diarization: in a layer of its own so the one above stays
# shared with vision/, and from the CPU index so pip can't pull a CUDA build
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torchaudio==2.5.1

# ffmpeg builds the proxy, feeds the detectors, extracts audio for transcription and burns in
# subtitles, with libass drawing them in DejaVu and, for Chinese, Japanese and Korean, Noto CJK.
# torchaudio needs libgomp.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core fonts-noto-cjk libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt constraints.txt ./
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt

COPY server.py detectors.py transnetv2.py transcribe.py diarize.py ./

# /videos is shared with the web app, which writes the uploads (both run as uid 1001)
RUN useradd --system --uid 1001 --create-home app \
 && mkdir -p /cache /videos && chown app /cache /videos
ENV VIDEO_CACHE=/cache VIDEO_DIR=/videos
USER app

EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
